generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id               Int         @id @default(autoincrement())
  name             String
  phone            String?
  website          String?
  city             String
  category         String
  rating           Float?
  reviews          Int?
  googleMapsUrl    String?
  address          String?
  businessCategory String?
  priceLevel       String?
  scrapedAt        DateTime    @default(now()) @db.Timestamptz(6)
  enrichment       Enrichment?
  contacts         BusinessContact[]
  deliveries       LeadDelivery[]

  @@unique([name, city, category])
  @@index([name])
  @@index([city])
  @@index([category])
  @@map("businesses")
}

model Enrichment {
  id          Int      @id @default(autoincrement())
  businessId  Int      @unique
  emails      String[] @default([])
  instagram   String?
  facebook    String?
  linkedin    String?
  twitter     String?
  youtube     String?
  tiktok      String?
  lastChecked DateTime @default(now()) @db.Timestamptz(6)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("enrichments")
}

model BusinessContact {
  id            Int      @id @default(autoincrement())
  businessId    Int
  name          String?
  title         String?
  email         String?
  phone         String?
  linkedin      String?
  twitter       String?
  sourceUrl     String
  sourceType    String   @default("website")
  sourcePage    String?
  emailType     String?
  roleCategory  String?
  domainMatches Boolean  @default(false)
  confidence    Int      @default(0)
  lastSeenAt    DateTime @default(now()) @db.Timestamptz(6)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@index([confidence])
  @@map("business_contacts")
}

model Plan {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  priceMonthlyUsd Int?
  leadsLimit      Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  users           User[]

  @@map("plans")
}

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  passwordHash           String
  name                   String?
  planId                 Int?
  leadsCollected         Int       @default(0)
  leadsUsedThisPeriod    Int       @default(0)
  currentPeriodStart     DateTime  @default(now()) @db.Timestamptz(6)
  currentPeriodEnd       DateTime  @db.Timestamptz(6)
  subscriptionStatus     String    @default("active")
  subscriptionCanceledAt DateTime? @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  apiKeys                ApiKey[]
  leadDeliveries         LeadDelivery[]
  plan                   Plan?     @relation(fields: [planId], references: [id])

  @@map("users")
}

model ApiKey {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  userId       Int?
  requestsUsed Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id])

  @@map("api_keys")
}

model LeadDelivery {
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  deliveredAt DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("lead_deliveries")
}

model JobRun {
  id             Int      @id @default(autoincrement())
  queueName      String
  jobId          String
  status         String
  startedAt      DateTime @default(now()) @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)
  durationMs     Int?
  processedCount Int?
  errorMessage   String?
  metadata       Json?
  webhookUrl     String?

  @@unique([queueName, jobId])
  @@index([queueName])
  @@index([status])
  @@map("job_runs")
}
