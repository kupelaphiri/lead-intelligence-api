generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id            Int         @id @default(autoincrement())
  name          String
  phone         String?
  website       String?
  city          String
  category      String
  rating        Float?
  reviews       Int?
  googleMapsUrl String?
  scrapedAt     DateTime    @default(now()) @db.Timestamptz(6)
  enrichment    Enrichment?

  @@unique([name, city, category])
  @@index([name])
  @@index([city])
  @@index([category])
  @@map("businesses")
}

model Enrichment {
  id          Int      @id @default(autoincrement())
  businessId  Int      @unique
  emails      String[] @default([])
  instagram   String?
  facebook    String?
  linkedin    String?
  lastChecked DateTime @default(now()) @db.Timestamptz(6)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("enrichments")
}

model Plan {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  priceMonthlyUsd Int?
  leadsLimit      Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  users           User[]

  @@map("plans")
}

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  passwordHash           String
  name                   String?
  planId                 Int?
  leadsCollected         Int       @default(0)
  subscriptionStatus     String    @default("active")
  subscriptionCanceledAt DateTime? @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  apiKeys                ApiKey[]
  plan                   Plan?     @relation(fields: [planId], references: [id])

  @@map("users")
}

model ApiKey {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  userId       Int?
  requestsUsed Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id])

  @@map("api_keys")
}
